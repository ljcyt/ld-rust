{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "卤蛋侠工单系统",
  "version": "0.1.0",
  "identifier": "com.haidilao.workorder",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "卤蛋侠工单系统",
        "width": 1000,
        "height": 650,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "dragDropEnabled": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
